# spring3-secret-scan

#!/bin/bash
set -e

echo "Starting Java Credential Scan..."

mkdir -p reports

gitleaks detect \
  --source . \
  --report-format json \
  --report-path reports/gitleaks.json

echo "Java Credential Scan completed successfully."

# spring3-secret-scan

#!/bin/bash
set -e

echo "Starting Java Unit Test CI check..."

mkdir -p reports

echo "Running Maven tests..."

mvn test

echo "Copying Maven test reports..."

cp -r target/surefire-reports/* reports/

echo "Java Unit Test CI check completed successfully."

# spring3-code-coverage

#!/bin/bash
set -e

echo "Starting Java Code Coverage CI check..."

mkdir -p reports

echo "Running Maven tests with JaCoCo..."

mvn clean test

echo "JaCoCo report generated by Maven."

echo "Copying JaCoCo coverage report..."

cp -r target/site/jacoco/. reports/

echo "Java Code Coverage CI check completed successfully."

# spring3-dependency-check

#!/bin/bash
set -e

echo "Starting Java Dependency Scan..."

mkdir -p reports

/opt/dependency-check/dependency-check/bin/dependency-check.sh \
  --project Spring3HibernateApp \
  --scan . \
  --format HTML \
  --out reports \
  --nvdApiKey "$NVD_API_KEY" \
  --nvdApiDelay 8000

echo "Java Dependency Scan completed successfully."